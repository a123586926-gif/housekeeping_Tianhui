{
  "name": "hotel-housekeeping-vercel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:photo-migration && npm run test:restore-readiness && npm run test:local-backup && npm run test:cleaner-policy && npm run test:cleaner-management && npm run test:cleaner-lifecycle && npm run test:session-access && tsc -b && vite build",
    "test:photo-migration": "node --test tests/production-photo-migration-audit.test.mjs",
    "test:restore-readiness": "node --test tests/restore-readiness.test.mjs",
    "test:local-backup": "node --test tests/local-production-backup.test.mjs",
    "test:cleaner-policy": "node --test tests/cleaner-management-policy.test.mjs",
    "test:cleaner-management": "node --test tests/qa-cleaner-management-contract.test.mjs",
    "test:cleaner-lifecycle": "node --test tests/qa-cleaner-lifecycle-simulation.test.mjs",
    "test:session-access": "node --test tests/session-access-authorization.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
